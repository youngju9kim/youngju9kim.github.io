[{"id":"bicycle-crunch","displayName":"바이시클크런치","englishName":"Bicycle Crunch","category":"CAT-CORE","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-CORE","secondaryMuscles":[],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["등을 대고 누워 손을 머리 뒤에 가볍게 둡니다.","한쪽 팔꿈치를 반대쪽 무릎 쪽으로 몸통과 함께 회전합니다.","몸통을 천천히 중앙으로 돌려 돌아옵니다."],"caution":"목을 손으로 당기지 말고 복부로 몸을 회전","photoSteps":[1,2,3]},{"id":"bird-dog","displayName":"버드독","englishName":"Bird Dog","category":"CAT-CORE","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-CORE","secondaryMuscles":["MUS-GLUTES"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["네발기기 자세에서 척추를 중립으로 유지합니다.","반대쪽 팔과 다리를 뻗어 골반이 흔들리지 않게 합니다.","손과 무릎을 천천히 몸 아래로 되돌립니다."],"caution":"허리를 꺾거나 골반을 회전시키지 않기","photoSteps":[1,2,3]},{"id":"dead-bug","displayName":"데드버그","englishName":"Dead Bug","category":"CAT-CORE","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-CORE","secondaryMuscles":[],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["등을 바닥에 대고 팔과 무릎을 90도로 듭니다.","한쪽 팔과 반대쪽 다리를 바닥 쪽으로 뻗습니다.","팔과 다리를 천천히 다시 90도 자세로 돌아옵니다."],"caution":"허리가 바닥에서 뜨지 않는 범위까지만 움직이기","photoSteps":[1,2,3]},{"id":"hollow-body-hold","displayName":"할로우바디홀드","englishName":"Hollow Body Hold","category":"CAT-CORE","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-CORE","secondaryMuscles":[],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":30,"repUnit":"seconds","restSec":60,"steps":["등을 대고 누워 팔과 다리를 천장 쪽으로 듭니다.","복부를 조이고 팔과 다리를 바닥 가까이 길게 뻗어 유지합니다.","팔과 다리를 천천히 들어 시작 자세로 돌아옵니다."],"caution":"허리가 바닥에서 뜨면 팔과 다리를 더 높게 조절","photoSteps":[1,2,3]},{"id":"mountain-climber","displayName":"마운틴클라이머","englishName":"Mountain Climber","category":"CAT-CORE","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-CORE","secondaryMuscles":["MUS-SHOULDER","MUS-QUADRICEPS"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["어깨 아래에 손을 두고 하이플랭크 자세를 만듭니다.","한쪽 무릎을 가슴 쪽으로 당기고 양쪽 다리를 번갈아 움직입니다.","양발을 뒤로 보내 안정적인 하이플랭크로 돌아옵니다."],"caution":"엉덩이가 들리거나 허리가 처지지 않도록 복부 유지","photoSteps":[1,2,3]},{"id":"plank","displayName":"플랭크","englishName":"Plank","category":"CAT-CORE","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-CORE","secondaryMuscles":["MUS-SHOULDER"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":30,"repUnit":"seconds","restSec":60,"steps":["팔꿈치를 어깨 아래에 두고 다리를 뒤로 뻗습니다.","머리부터 발뒤꿈치까지 일직선을 유지하며 복부에 힘을 줍니다.","무릎을 바닥에 내려 통제된 방식으로 마무리합니다."],"caution":"허리가 처지거나 엉덩이를 과도하게 들지 않기","photoSteps":[1,2,3]},{"id":"reverse-crunch","displayName":"리버스크런치","englishName":"Reverse Crunch","category":"CAT-CORE","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-CORE","secondaryMuscles":[],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["등을 대고 누워 무릎을 90도로 듭니다.","복부를 수축해 무릎을 가슴 쪽으로 당기고 골반을 살짝 듭니다.","골반을 천천히 내려 시작 자세로 돌아옵니다."],"caution":"반동을 사용하지 말고 허리가 과하게 뜨지 않게 주의","photoSteps":[1,2,3]},{"id":"side-plank","displayName":"사이드플랭크","englishName":"Side Plank","category":"CAT-CORE","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-CORE","secondaryMuscles":["MUS-SHOULDER"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":30,"repUnit":"seconds","restSec":60,"steps":["옆으로 누워 팔꿈치와 무릎을 바닥에 둡니다.","팔꿈치로 바닥을 밀어 몸을 일직선으로 들어 올립니다.","엉덩이를 천천히 바닥으로 내려 돌아옵니다."],"caution":"어깨를 팔꿈치 위에 두고 골반이 뒤로 빠지지 않게 유지","photoSteps":[1,2,3]},{"id":"sit-up","displayName":"윗몸일으키기","englishName":"Sit-up","category":"CAT-CORE","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-CORE","secondaryMuscles":[],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["등을 대고 누워 무릎을 세우고 발을 바닥에 둡니다.","복부에 힘을 주어 상체를 말아 올리되 목을 당기지 않습니다.","등을 천천히 바닥으로 내려 시작 자세로 돌아옵니다."],"caution":"목을 당기거나 허리 반동으로 올라오지 않기","photoSteps":[1,2,3]}]
