category":"CAT-LEG","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-QUADRICEPS","secondaryMuscles":["MUS-GLUTES"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["두 발을 모으고 가슴을 편 채로 섭니다.","한 발을 뒤로 내딛고 양 무릎을 굽힙니다.","앞발로 바닥을 밀어 서 있는 자세로 돌아옵니다."],"caution":"앞무릎이 발끝 안쪽으로 무너지지 않게 유지","photoSteps":[1,2,3]},{"id":"seated-leg-curl","displayName":"시티드레그컬","englishName":"Seated Leg Curl","category":"CAT-LEG","machineType":"MCH-SELECTORIZED","primaryMuscle":"MUS-HAMSTRINGS","secondaryMuscles":["MUS-CALVES"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["등을 등받이에 붙이고 발목을 패드 위에 둡니다.","발뒤꿈치를 아래·뒤쪽으로 당겨 무릎을 굽힙니다.","중량을 천천히 풀어 다리를 폅니다."],"caution":"엉덩이가 들리거나 허리를 과도하게 젖히지 않기","photoSteps":[1,2,3]},{"id":"side-lunge","displayName":"사이드런지","englishName":"Side Lunge","category":"CAT-LEG","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-ADDUCTORS","secondaryMuscles":["MUS-QUADRICEPS","MUS-GLUTES"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["두 발을 모으고 가슴을 편 채로 섭니다.","한쪽으로 크게 내딛고 엉덩이를 뒤로 보내 무릎을 굽힙니다.","굽힌 다리로 바닥을 밀어 중앙으로 돌아옵니다."],"caution":"발끝과 무릎 방향을 맞추고 반대쪽 다리는 길게 유지","photoSteps":[1,2,3]},{"id":"single-leg-glute-bridge","displayName":"싱글레그글루트브리지","englishName":"Single-leg Glute Bridge","category":"CAT-LEG","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-GLUTES","secondaryMuscles":["MUS-HAMSTRINGS","MUS-CORE"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["누워 한쪽 무릎을 세우고 반대쪽 다리를 뻗습니다.","발뒤꿈치로 바닥을 눌러 엉덩이를 들어 올립니다.","엉덩이를 천천히 바닥으로 내려 돌아옵니다."],"caution":"골반이 한쪽으로 기울지 않도록 복부에 힘 유지","photoSteps":[1,2,3]},{"id":"smith-squat","displayName":"스미스머신스쿼트","englishName":"Smith Machine Squat","category":"CAT-LEG","machineType":"MCH-SMITH","primaryMuscle":"MUS-QUADRICEPS","secondaryMuscles":["MUS-GLUTES","MUS-CORE"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["바를 승모근 위에 두고 발을 안정적으로 놓습니다.","가슴을 세우고 무릎 방향을 유지하며 앉습니다.","발바닥으로 바닥을 밀어 일어납니다."],"caution":"허리가 과도하게 꺾이거나 무릎이 안쪽으로 모이지 않기","photoSteps":[1,2,3]},{"id":"squat","displayName":"스쿼트","englishName":"Bodyweight Squat","category":"CAT-LEG","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-QUADRICEPS","secondaryMuscles":["MUS-GLUTES","MUS-CORE"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["발을 어깨너비로 벌리고 발끝을 약간 바깥쪽으로 둡니다.","엉덩이를 뒤로 빼며 가슴을 세우고 무릎을 굽힙니다.","발바닥으로 바닥을 밀어 바르게 일어섭니다."],"caution":"무릎이 안쪽으로 모이거나 허리가 과도하게 굽지 않기","photoSteps":[1,2,3]},{"id":"standing-calf-raise","displayName":"스탠딩카프레이즈","englishName":"Standing Calf Raise","category":"CAT-LEG","machineType":"MCH-SELECTORIZED","primaryMuscle":"MUS-CALVES","secondaryMuscles":[],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["어깨 패드 아래에 서서 발 앞부분을 플랫폼에 올립니다.","발끝으로 올라가 발목을 폅니다.","뒤꿈치를 천천히 아래로 내립니다."],"caution":"발목이 바깥으로 꺾이거나 무릎을 잠그지 않기","photoSteps":[1,2,3]},{"id":"wall-sit","displayName":"월싯","englishName":"Wall Sit","category":"CAT-LEG","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-QUADRICEPS","secondaryMuscles":["MUS-GLUTES"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":40,"repUnit":"seconds","restSec":60,"steps":["벽에 등을 대고 발을 벽에서 적당히 앞으로 둡니다.","무릎을 굽혀 허벅지가 바닥과 평행한 자세를 만듭니다.","발로 바닥을 밀며 천천히 일어나 돌아옵니다."],"caution":"무릎이 발끝보다 과하게 앞으로 나오지 않게 조절","photoSteps":[1,2,3]}]
