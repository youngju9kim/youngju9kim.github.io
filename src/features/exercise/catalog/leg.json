[{"id":"bodyweight-calf-raise","displayName":"카프레이즈","englishName":"Bodyweight Calf Raise","category":"CAT-LEG","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-CALVES","secondaryMuscles":[],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["발을 골반 너비로 벌리고 똑바로 섭니다.","발뒤꿈치를 높이 들어 발끝으로 섭니다.","발뒤꿈치를 천천히 내려 바닥에 닿게 합니다."],"caution":"발목이 바깥이나 안쪽으로 꺾이지 않게 유지","photoSteps":[1,2,3]},{"id":"glute-bridge","displayName":"글루트브리지","englishName":"Glute Bridge","category":"CAT-LEG","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-GLUTES","secondaryMuscles":["MUS-HAMSTRINGS","MUS-CORE"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["등을 대고 누워 무릎을 굽히고 발바닥을 바닥에 둡니다.","엉덩이를 조이며 골반을 들어 몸통과 허벅지를 맞춥니다.","엉덩이를 천천히 바닥으로 내립니다."],"caution":"허리를 꺾어 올리거나 무릎이 바깥으로 벌어지지 않기","photoSteps":[1,2,3]},{"id":"hack-squat","displayName":"핵스쿼트","englishName":"Hack Squat","category":"CAT-LEG","machineType":"MCH-PLATE","primaryMuscle":"MUS-QUADRICEPS","secondaryMuscles":["MUS-GLUTES"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["등과 어깨를 패드에 붙이고 발을 플랫폼에 둡니다.","무릎이 발끝 방향을 따라가도록 몸을 낮춥니다.","발바닥으로 플랫폼을 밀어 일어납니다."],"caution":"무릎이 안쪽으로 무너지거나 허리가 뜨지 않기","photoSteps":[1,2,3]},{"id":"hip-abduction","displayName":"힙어브덕션","englishName":"Hip Abduction","category":"CAT-LEG","machineType":"MCH-SELECTORIZED","primaryMuscle":"MUS-GLUTES","secondaryMuscles":[],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["기구에 앉아 무릎 바깥쪽을 패드에 댑니다.","상체를 세운 채 무릎을 바깥으로 벌립니다.","중량을 통제하며 무릎을 안쪽으로 모읍니다."],"caution":"상체를 흔들거나 반동으로 벌리지 않기","photoSteps":[1,2,3]},{"id":"hip-adduction","displayName":"힙어덕션","englishName":"Hip Adduction","category":"CAT-LEG","machineType":"MCH-SELECTORIZED","primaryMuscle":"MUS-ADDUCTORS","secondaryMuscles":[],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["기구에 앉아 다리를 벌리고 허리를 