[{"id":"assisted-pullup","displayName":"어시스트풀업","englishName":"Assisted Pull-up","category":"CAT-BACK","machineType":"MCH-SELECTORIZED","primaryMuscle":"MUS-BACK","secondaryMuscles":["MUS-BICEPS","MUS-SHOULDER"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["보조 패드에 올라 평행 손잡이를 잡고 팔을 폅니다.","팔꿈치를 아래로 당겨 가슴을 손잡이 쪽으로 올립니다.","몸을 통제하며 팔을 펴고 내려옵니다."],"caution":"어깨를 으쓱하거나 몸을 흔들어 올라가지 않기","photoSteps":[1,2,3]},{"id":"cable-pullover","displayName":"케이블풀오버","englishName":"Cable Pullover","category":"CAT-BACK","machineType":"MCH-CABLE","primaryMuscle":"MUS-BACK","secondaryMuscles":["MUS-CORE"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["케이블을 잡고 팔을 머리 위로 뻗어 엉덩이를 살짝 뒤로 뺍니다.","팔을 길게 유지하며 바를 허벅지 쪽으로 내립니다.","팔을 천천히 머리 위로 되돌립니다."],"caution":"허리를 과도하게 젖히거나 팔꿈치를 많이 굽히지 않기","photoSteps":[1,2,3]},{"id":"lat-pulldown","displayName":"랫풀다운","englishName":"Lat Pulldown","category":"CAT-BACK","machineType":"MCH-CABLE","primaryMuscle":"MUS-BACK","secondaryMuscles":["MUS-BICEPS","MUS-SHOULDER"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["허벅지를 패드로 고정하고 바를 넓게 잡습니다.","팔꿈치를 아래로 당기며 바를 가슴 위쪽으로 내립니다.","팔을 천천히 펴며 바를 머리 위로 돌려보냅니다."],"caution":"바를 목 뒤로 내리거나 몸을 과도하게 젖히지 않기","photoSteps":[1,2,3]},{"id":"machine-row","displayName":"머신로우","englishName":"Machine Row","category":"CAT-BACK","machineType":"MCH-PLATE","primaryMuscle":"MUS-BACK","secondaryMuscles":["MUS-BICEPS"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["가슴을 패드에 붙이고 팔을 뻗어 손잡이를 잡습니다.","가슴을 패드에 붙인 채 손잡이를 갈비뼈 쪽으로 당깁니다.","팔을 천천히 앞으로 뻗습니다."],"caution":"목을 앞으로 빼거나 허리를 꺾지 않기","photoSteps":[1,2,3]},{"id":"reverse-plank","displayName":"리버스플랭크","englishName":"Reverse Plank","category":"CAT-BACK","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-BACK","secondaryMuscles":["MUS-GLUTES","MUS-CORE"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":30,"repUnit":"seconds","restSec":60,"steps":["다리를 앞으로 뻗고 손을 엉덩이 뒤에 짚습니다.","엉덩이를 들어 어깨부터 발목까지 일직선을 만듭니다.","엉덩이를 천천히 내려 원래 자세로 돌아옵니다."],"caution":"어깨를 귀에서 멀리하고 허리가 꺾이지 않게 유지","photoSteps":[1,2,3]},{"id":"reverse-snow-angel","displayName":"리버스스노우엔젤","englishName":"Reverse Snow Angel","category":"CAT-BACK","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-BACK","secondaryMuscles":["MUS-SHOULDER"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["엎드려 팔을 몸 옆에 둡니다.","팔을 곧게 유지하며 바닥 위로 머리 쪽까지 쓸어 올립니다.","팔을 다시 몸 옆으로 천천히 내립니다."],"caution":"어깨를 으쓱하지 말고 팔의 움직임을 천천히 통제","photoSteps":[1,2,3]},{"id":"seated-row","displayName":"시티드로우","englishName":"Seated Cable Row","category":"CAT-BACK","machineType":"MCH-CABLE","primaryMuscle":"MUS-BACK","secondaryMuscles":["MUS-BICEPS"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["무릎을 약간 굽히고 상체를 세워 손잡이를 잡습니다.","팔꿈치를 몸 가까이 붙여 손잡이를 아랫갈비뼈로 당깁니다.","등을 둥글게 말지 않고 팔을 천천히 폅니다."],"caution":"상체를 뒤로 젖히며 반동으로 당기지 않기","photoSteps":[1,2,3]},{"id":"straight-arm-pulldown","displayName":"스트레이트암풀다운","englishName":"Straight-arm Pulldown","category":"CAT-BACK","machineType":"MCH-CABLE","primaryMuscle":"MUS-BACK","secondaryMuscles":["MUS-CORE"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["케이블을 마주 보고 팔을 머리 위로 올려 바를 잡습니다.","팔을 거의 편 상태로 바를 허벅지까지 호를 그리며 내립니다.","광배근 긴장을 유지하며 바를 천천히 올립니다."],"caution":"팔꿈치를 굽혀 삼두근 운동처럼 수행하지 않기","photoSteps":[1,2,3]},{"id":"superman","displayName":"슈퍼맨","englishName":"Superman","category":"CAT-BACK","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-BACK","secondaryMuscles":["MUS-GLUTES"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["엎드려 팔과 다리를 길게 뻗고 몸을 편안히 둡니다.","팔과 가슴과 허벅지를 바닥에서 살짝 들어 올립니다.","팔과 다리를 천천히 내려 원래 자세로 돌아옵니다."],"caution":"허리를 과하게 꺾지 말고 목은 중립으로 유지","photoSteps":[1,2,3]}]
