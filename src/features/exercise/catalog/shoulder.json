[{"id":"bear-crawl","displayName":"베어크롤","englishName":"Bear Crawl","category":"CAT-SHOULDER","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-CORE","secondaryMuscles":["MUS-SHOULDER","MUS-QUADRICEPS"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["손과 발을 바닥에 두고 무릎을 바닥에서 살짝 띄웁니다.","반대 손과 발을 함께 앞으로 옮기며 이동합니다.","천천히 안정된 네발 자세로 돌아옵니다."],"caution":"무릎을 낮게 유지하고 허리가 흔들리지 않게 주의","photoSteps":[1,2,3]},{"id":"cable-face-pull","displayName":"케이블페이스풀","englishName":"Cable Face Pull","category":"CAT-SHOULDER","machineType":"MCH-CABLE","primaryMuscle":"MUS-SHOULDER","secondaryMuscles":["MUS-BACK"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["케이블을 마주 보고 로프를 얼굴 높이에서 잡습니다.","팔꿈치를 높게 유지하며 로프를 얼굴 양옆으로 당깁니다.","팔을 천천히 앞으로 뻗습니다."],"caution":"허리를 젖혀 당기거나 팔꿈치를 아래로 떨어뜨리지 않기","photoSteps":[1,2,3]},{"id":"cable-lateral-raise","displayName":"케이블레터럴레이즈","englishName":"Cable Lateral Raise","category":"CAT-SHOULDER","machineType":"MCH-CABLE","primaryMuscle":"MUS-SHOULDER","secondaryMuscles":[],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["케이블 옆에 서서 먼 손으로 손잡이를 잡습니다.","팔을 옆으로 들어 어깨 높이까지 올립니다.","팔을 천천히 몸 앞쪽으로 내립니다."],"caution":"어깨 높이보다 높게 들거나 몸을 기울이지 않기","photoSteps":[1,2,3]},{"id":"inchworm","displayName":"인치웜","englishName":"Inchworm","category":"CAT-SHOULDER","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-CORE","secondaryMuscles":["MUS-SHOULDER","MUS-HAMSTRINGS"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["발을 골반 너비로 벌리고 선 자세에서 시작합니다.","손을 바닥으로 걸어가 몸을 일직선으로 만듭니다.","손을 발 쪽으로 걸어 천천히 일어납니다."],"caution":"허리를 둥글게 말지 말고 가능한 범위에서 진행","photoSteps":[1,2,3]},{"id":"machine-lateral-raise","displayName":"머신레터럴레이즈","englishName":"Machine Lateral Raise","category":"CAT-SHOULDER","machineType":"MCH-SELECTORIZED","primaryMuscle":"MUS-SHOULDER","secondaryMuscles":[],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["팔꿈치를 패드에 대고 상체를 세워 앉습니다.","팔꿈치를 바깥쪽으로 들어 어깨 높이까지 올립니다.","팔꿈치를 천천히 내려 시작 자세로 돌아옵니다."],"caution":"어깨를 으쓱하거나 반동으로 들어 올리지 않기","photoSteps":[1,2,3]},{"id":"machine-shoulder-press","displayName":"머신숄더프레스","englishName":"Machine Shoulder Press","category":"CAT-SHOULDER","machineType":"MCH-SELECTORIZED","primaryMuscle":"MUS-SHOULDER","secondaryMuscles":["MUS-TRICEPS"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["등을 등받이에 붙이고 손잡이를 어깨 높이에서 잡습니다.","손잡이를 위로 밀어 팔을 폅니다.","손잡이를 천천히 어깨 높이로 내립니다."],"caution":"허리를 꺾거나 손잡이를 머리 뒤로 내리지 않기","photoSteps":[1,2,3]},{"id":"pike-push-up","displayName":"파이크푸시업","englishName":"Pike Push-up","category":"CAT-SHOULDER","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-SHOULDER","secondaryMuscles":["MUS-TRICEPS"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["손을 어깨너비로 짚고 엉덩이를 높입니다.","팔꿈치를 굽혀 머리와 어깨를 바닥 쪽으로 낮춥니다.","팔로 바닥을 밀어 엉덩이를 높인 자세로 돌아옵니다."],"caution":"팔꿈치를 옆으로 벌리지 말고 목에 힘을 주지 않기","photoSteps":[1,2,3]},{"id":"rear-delt-fly","displayName":"리어델트플라이","englishName":"Rear Delt Fly","category":"CAT-SHOULDER","machineType":"MCH-SELECTORIZED","primaryMuscle":"MUS-SHOULDER","secondaryMuscles":["MUS-BACK"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["가슴을 패드에 붙이고 손잡이를 앞에서 잡습니다.","팔을 양옆으로 벌려 어깨선까지 엽니다.","손잡이를 천천히 앞쪽으로 되돌립니다."],"caution":"허리를 들거나 팔을 과도하게 뒤로 보내지 않기","photoSteps":[1,2,3]},{"id":"shoulder-tap-plank","displayName":"숄더탭플랭크","englishName":"Shoulder Tap Plank","category":"CAT-SHOULDER","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-CORE","secondaryMuscles":["MUS-SHOULDER"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["손을 어깨 아래에 두고 몸을 일직선으로 만듭니다.","한 손을 들어 반대쪽 어깨를 가볍게 터치합니다.","손을 바닥에 내려 양손 플랭크로 돌아옵니다."],"caution":"골반이 좌우로 흔들리지 않도록 발을 조금 넓게 벌리기","photoSteps":[1,2,3]},{"id":"sphinx-push-up","displayName":"스핑크스푸시업","englishName":"Sphinx Push-up","category":"CAT-SHOULDER","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-TRICEPS","secondaryMuscles":["MUS-SHOULDER","MUS-CORE"],"difficulty":"LV-2","safety":"SAFE-B","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["팔꿈치와 전완을 바닥에 둔 낮은 플랭크 자세를 만듭니다.","손바닥으로 바닥을 밀며 가슴과 어깨를 들어 올립니다.","팔꿈치를 굽혀 천천히 낮은 자세로 돌아옵니다."],"caution":"허리가 꺾이지 않도록 복부와 둔부에 힘 유지","photoSteps":[1,2,3]},{"id":"ytw-raise","displayName":"YTW레이즈","englishName":"Y-T-W Raise","category":"CAT-SHOULDER","machineType":"MCH-BODYWEIGHT","primaryMuscle":"MUS-SHOULDER","secondaryMuscles":["MUS-BACK"],"difficulty":"LV-1","safety":"SAFE-A","sets":3,"reps":12,"repUnit":"reps","restSec":60,"steps":["엎드려 팔을 앞으로 뻗고 복부에 힘을 줍니다.","팔을 Y자 방향으로 들어 올리며 견갑골을 조입니다.","팔을 천천히 내려 시작 자세로 돌아옵니다."],"caution":"허리를 들썩이지 말고 팔보다 견갑골 움직임에 집중","photoSteps":[1,2,3]}]
